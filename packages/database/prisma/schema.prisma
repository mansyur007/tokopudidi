// Prisma schema untuk Tokopudidi.
// Catatan: harga dan ongkir disimpan sebagai Int (rupiah penuh) — tidak pakai float untuk hindari floating point error.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= ENUMS =============

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductCondition {
  NEW
  USED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  // Batas waktu bayar (QRIS mock, 15 menit) terlewat — dibedakan dari CANCELLED
  // yang berarti dibatalkan pembeli/penjual. Lihat M10-A5.
  EXPIRED
}

enum PaymentMethod {
  COD
  TRANSFER_MANUAL
  QRIS_MOCK
}

enum ShippingMethod {
  REGULAR
  SAME_DAY
  PICKUP_SENDIRI
}

enum NotificationType {
  ORDER_UPDATE
  NEW_MESSAGE
  PROMO
  SYSTEM
  NEW_QUESTION
  // M13-B2. Sengaja terpisah dari PROMO: broadcast toko dikirim massal ke
  // follower, jadi harus bisa dibedakan (dan nanti dibisukan) tanpa ikut
  // membungkam notifikasi promo yang dipicu aksi user sendiri.
  SHOP_BROADCAST
}

enum BannerPlacement {
  HOME_TOP
  HOME_MIDDLE
  CATEGORY_PAGE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}

// ============= USER & AUTH =============

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  email           String?   @unique
  passwordHash    String
  fullName        String
  role            UserRole  @default(BUYER)
  isPhoneVerified Boolean   @default(false)
  avatarUrl       String?
  referralCode    String    @unique
  referredById    String?
  referredBy      User?     @relation("UserReferral", fields: [referredById], references: [id])
  referrals       User[]    @relation("UserReferral")
  isSuspended     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  addresses          Address[]
  shop               Shop?
  cart               Cart?
  orders             Order[]             @relation("BuyerOrders")
  reviews            Review[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  otpCodes           OtpCode[]
  chatMessages       ChatMessage[]
  buyerRooms         ChatRoom[]          @relation("BuyerRoom")
  refundRequests     RefundRequest[]
  paymentVerifs      PaymentProof[]      @relation("VerifiedBy")
  wishlists          Wishlist[]
  productViews       ProductView[]
  searchHistory      SearchHistory[]
  discussions        Discussion[]
  discussionHelpfuls DiscussionHelpful[]
  reports            Report[]
  complaints         Complaint[]
  adminLogs          AdminLog[]
  followedShops      ShopFollower[]

  @@index([phone])
  @@index([referralCode])
}

// Jejak audit aksi tulis admin (M12-C3). Append-only: tidak ada route
// update/delete, dan tidak ada relasi yang bisa menghapusnya secara kaskade.
model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  // Sengaja TANPA onDelete: Cascade — default Prisma di Postgres adalah
  // ON DELETE RESTRICT, dan itulah yang benar untuk jejak audit: log tidak
  // boleh ikut hilang bersama pelakunya. Aman karena app ini soft-delete user
  // lewat `deletedAt`, tidak pernah hard delete.
  admin      User     @relation(fields: [adminId], references: [id])
  // Konstanta dari ADMIN_ACTIONS di @tokopudidi/shared, mis. "TAKEDOWN_PRODUCT".
  // Disimpan sebagai String, bukan enum, supaya menambah aksi baru tidak butuh
  // migration — daftar sahnya dijaga zod di sisi tulis.
  action     String
  targetType String?
  targetId   String?
  // Body request yang sudah dilewatkan redactAdminPayload — data-URI dibuang
  // dan string panjang dipotong. Tanpa itu satu banner base64 2MB masuk ke sini.
  payload    Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  code      String
  purpose   String // "REGISTER" | "LOGIN" | "RESET_PASSWORD"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  recipientName  String
  recipientPhone String
  province       String
  city           String
  district       String
  subdistrict    String
  postalCode     String
  fullAddress    String
  latitude       Float?
  longitude      Float?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ============= SHOP =============

model Shop {
  id              String    @id @default(uuid())
  ownerId         String    @unique
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug            String    @unique
  name            String
  description     String?
  logoUrl         String?
  bannerUrl       String?
  city            String
  province        String?
  isOpen          Boolean   @default(true)
  closedReason    String?
  joinedAt        DateTime  @default(now())
  ratingAvg       Float     @default(0)
  ratingCount     Int       @default(0)
  totalSold       Int       @default(0)
  ktpVerified     Boolean   @default(false)
  // Di-set admin (M10-A10) — dipakai filter "Official Store" di pencarian.
  // Badge & tampilannya menyusul di M14-B1.
  isOfficialStore Boolean   @default(false)
  ktpUrl          String? // hanya admin akses via signed URL
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  balance         Int       @default(0) // dalam rupiah
  pendingBalance  Int       @default(0)
  autoReplyText   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  products      Product[]
  orders        Order[]
  reviews       Review[]
  chatRooms     ChatRoom[]
  withdrawals   Withdrawal[]
  chatTemplates ChatTemplate[]
  promoCodes    PromoCode[]
  showcases     ShopShowcase[]
  followers     ShopFollower[]
  broadcasts    ShopBroadcast[]

  @@index([slug])
  @@index([city])
}

// ============= CATEGORY =============

model Category {
  id        String     @id @default(uuid())
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  name      String
  slug      String     @unique
  iconUrl   String?
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([slug])
}

// ============= PRODUCT =============

model Product {
  id                   String           @id @default(uuid())
  shopId               String
  shop                 Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId           String
  category             Category         @relation(fields: [categoryId], references: [id])
  name                 String
  slug                 String           @unique
  description          String           @db.Text
  price                Int
  // Sale price periodik (M9-B3) — aktif kalau salePrice terisi & now di dalam periode.
  salePrice            Int?
  saleStartAt          DateTime?
  saleEndAt            DateTime?
  stock                Int
  minOrderQty          Int              @default(1)
  weight               Int // gram
  condition            ProductCondition @default(NEW)
  // Opsi pengiriman per produk (M10-A10) — di-set seller, jadi filter di pencarian
  // sekaligus ditegakkan saat checkout.
  // COD default true supaya produk lama tidak mendadak kehilangan opsi bayar di tempat.
  codAvailable         Boolean          @default(true)
  freeShippingEligible Boolean          @default(false)
  // Pre-order (M15-B1) — murni informasi, tidak ada SLA/auto-cancel otomatis.
  // preorderDays wajib terisi (1-90) kalau isPreorder true; ditegakkan di route,
  // bukan di schema, supaya update parsial tetap bisa mengubah field lain tanpa
  // mengulang keduanya.
  isPreorder           Boolean          @default(false)
  preorderDays         Int?
  isActive             Boolean          @default(true)
  soldCount            Int              @default(0)
  viewCount            Int              @default(0)
  ratingAvg            Float            @default(0)
  ratingCount          Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  images         ProductImage[]
  variants       ProductVariant[]
  options        ProductOption[]
  cartItems      CartItem[]
  reviews        Review[]
  orderItems     OrderItem[]
  wishlistedBy   Wishlist[]
  views          ProductView[]
  discussions    Discussion[]
  showcaseItems  ShopShowcaseProduct[]
  wholesaleTiers ProductWholesaleTier[]
  broadcasts     ShopBroadcast[]
  flashSaleItems FlashSaleItem[]
  // searchVector dikelola via raw SQL trigger di migration

  @@index([shopId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
}

// Harga grosir bertingkat (M13-B1). Satu baris = "beli minimal N, harganya X".
// Tanpa kolom `order`: urutannya sudah ditentukan `minQty`, dan menyimpan urutan
// terpisah hanya membuka peluang urutan yang bertentangan dengan angkanya.
model ProductWholesaleTier {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Kuantitas minimum agar harga tier ini berlaku (selalu >= 2 — lihat validasi).
  minQty    Int
  // Harga satuan pada tier ini, dalam rupiah.
  price     Int

  // Satu produk tidak boleh punya dua tier dengan ambang yang sama: harganya
  // jadi ambigu. Unique index ini sekaligus melayani pengurutan per produk,
  // jadi tidak ada @@index terpisah.
  @@unique([productId, minQty])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
}

// Variant multi-axis (M11-A8). `ProductVariant` tetap jadi baris "kombinasi" —
// id-nya dipegang CartItem (FK) dan OrderItem (kolom polos, tanpa FK), jadi
// tidak boleh diganti model. Yang baru cuma lapisan option/value di atasnya.
model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Label gabungan hasil turunan dari `values`, mis. "Merah / M". Ditulis ulang
  // tiap kali variant disimpan. Dipertahankan karena dipakai snapshot
  // OrderItem.variantName dan sebagai fallback untuk data yang belum di-backfill.
  // Rencana drop kolom ini ada di tahap 4 M11-A8 — terpisah, setelah verifikasi.
  name          String
  priceModifier Int     @default(0)
  stock         Int     @default(0)
  isActive      Boolean @default(true)
  // Gambar khusus kombinasi ini (mis. foto warna merah). Null = pakai galeri produk.
  imageUrl      String?

  cartItems CartItem[]
  values    ProductVariantValue[]

  @@index([productId])
}

model ProductOption {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // "Warna", "Ukuran"
  order     Int     @default(0)

  values ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, order])
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String // "Merah", "M"
  order    Int           @default(0)

  variantValues ProductVariantValue[]

  @@unique([optionId, value])
  @@index([optionId, order])
}

model ProductVariantValue {
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// ============= CART =============

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  addedAt   DateTime        @default(now())

  @@index([cartId])
}

// ============= ORDER =============

model Order {
  id             String         @id @default(uuid())
  orderNumber    String         @unique
  buyerId        String
  buyer          User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id])
  addressId      String?
  address        Address?       @relation(fields: [addressId], references: [id])
  status         OrderStatus    @default(PENDING_PAYMENT)
  subtotal       Int
  shippingCost   Int
  discountAmount Int            @default(0)
  total          Int
  paymentMethod  PaymentMethod
  shippingMethod ShippingMethod
  trackingNumber String?
  courierName    String?
  buyerAddress   Json // snapshot
  shopAddress    Json // snapshot
  notes          String?
  promoCode      String?
  paidAt         DateTime?
  processedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items         OrderItem[]
  paymentProof  PaymentProof?
  refundRequest RefundRequest?
  complaints    Complaint[]

  @@index([buyerId])
  @@index([shopId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  variantId    String?
  productName  String
  productImage String?
  variantName  String?
  price        Int
  quantity     Int
  subtotal     Int
  // Snapshot lama pre-order (M15-B1), pola yang sama dengan productName/price:
  // seller mengubah `Product.preorderDays` tidak boleh mengubah estimasi pada
  // pesanan yang sudah dibuat. Null kalau produknya bukan pre-order saat dibeli.
  preorderDays Int?
  // Snapshot slot flash sale yang dipakai baris ini (M15-C1) — terisi HANYA
  // kalau harga flash yang benar-benar menang. Tanpa kolom ini, pelepasan kuota
  // saat pesanan batal harus menebak-nebak item mana yang dulu memakai flash
  // (harga snapshot saja tidak cukup: harga flash bisa berubah setelahnya).
  flashSaleItemId String?
  flashSaleItem   FlashSaleItem? @relation(fields: [flashSaleItemId], references: [id], onDelete: SetNull)

  review    Review?
  complaint Complaint?

  @@index([orderId])
  // Dipakai admin untuk memastikan sebuah slot belum pernah terpakai sebelum
  // boleh dihapus.
  @@index([flashSaleItemId])
}

model PaymentProof {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bankName       String
  accountName    String
  transferAmount Int
  proofImageUrl  String
  uploadedAt     DateTime  @default(now())
  verifiedAt     DateTime?
  verifiedById   String?
  verifiedBy     User?     @relation("VerifiedBy", fields: [verifiedById], references: [id])
  rejectedAt     DateTime?
  rejectReason   String?
}

// ============= REVIEW =============

model Review {
  id              String    @id @default(uuid())
  orderItemId     String    @unique
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User      @relation(fields: [buyerId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id])
  rating          Int // 1-5
  comment         String?
  imageUrls       String[]
  sellerReply     String?
  sellerRepliedAt DateTime?
  isHidden        Boolean   @default(false)
  isReported      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([productId])
  @@index([shopId])
  @@index([buyerId])
}

// ============= CHAT =============

model ChatRoom {
  id            String   @id @default(uuid())
  buyerId       String
  buyer         User     @relation("BuyerRoom", fields: [buyerId], references: [id])
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ChatMessage[]

  @@unique([buyerId, shopId])
  @@index([buyerId])
  @@index([shopId])
}

model ChatMessage {
  id         String    @id @default(uuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User      @relation(fields: [senderId], references: [id])
  content    String
  imageUrl   String?
  readAt     DateTime?
  isReported Boolean   @default(false)
  sentAt     DateTime  @default(now())

  @@index([roomId])
}

// ============= NOTIFICATION =============

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// ============= BANNER =============

model Banner {
  id         String          @id @default(uuid())
  imageUrl   String
  linkUrl    String?
  order      Int             @default(0)
  isActive   Boolean         @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  placement  BannerPlacement @default(HOME_TOP)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ============= PROMO =============

model PromoCode {
  id            String       @id @default(uuid())
  code          String       @unique
  // null = voucher platform (berlaku semua toko); terisi = voucher khusus toko (M9-B2).
  shopId        String?
  shop          Shop?        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  discountType  DiscountType
  discountValue Int
  minPurchase   Int          @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int          @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
  @@index([shopId, isActive])
}

// ============= REFUND =============

model RefundRequest {
  id             String       @id @default(uuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id])
  requestedById  String
  requestedBy    User         @relation(fields: [requestedById], references: [id])
  reason         String
  evidenceImages String[]
  status         RefundStatus @default(PENDING)
  adminNote      String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ============= KOMPLAIN / RETURN (M10-A7) =============

enum ComplaintType {
  BROKEN
  NOT_AS_DESCRIBED
  MISSING_ITEM
  OTHER
}

enum ComplaintResolution {
  REFUND
  REPLACEMENT
}

enum ComplaintStatus {
  OPEN
  SELLER_RESPONDED // seller menolak — bola di buyer untuk escalate
  ESCALATED
  RESOLVED
  REJECTED
}

// Komplain per item pesanan, diajukan dalam 2 hari sejak barang diterima.
// Berbeda dari RefundRequest (per order, langsung ke admin): komplain lewat
// seller dulu, dan bisa berujung penggantian barang, bukan hanya uang kembali.
model Complaint {
  id             String              @id @default(uuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Satu item hanya bisa dikomplain sekali — kelanjutannya lewat escalate.
  orderItemId    String              @unique
  orderItem      OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User                @relation(fields: [buyerId], references: [id])
  type           ComplaintType
  description    String
  evidenceUrls   String[]
  resolutionType ComplaintResolution
  status         ComplaintStatus     @default(OPEN)
  sellerResponse String?
  adminDecision  String?
  createdAt      DateTime            @default(now())
  respondedAt    DateTime?
  escalatedAt    DateTime?
  resolvedAt     DateTime?

  @@index([buyerId, status])
  @@index([status, createdAt])
  @@index([orderId])
}

// ============= WISHLIST =============

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

// ============= RECENTLY VIEWED =============

model ProductView {
  id         String   @id @default(uuid())
  userId     String?
  sessionKey String?
  productId  String
  viewedAt   DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([sessionKey, productId])
  @@index([userId, viewedAt])
  @@index([sessionKey, viewedAt])
}

// ============= SEARCH HISTORY =============

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  query      String
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
}

// ============= WITHDRAWAL (seller payout) =============

model Withdrawal {
  id            String    @id @default(uuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id])
  amount        Int
  status        String    @default("PENDING") // PENDING | PROCESSED | REJECTED
  bankName      String
  bankAccountNo String
  requestedAt   DateTime  @default(now())
  processedAt   DateTime?
  note          String?

  @@index([shopId])
}

// ============= DISCUSSION (Tanya Jawab Publik di halaman produk) =============

model Discussion {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  parentId      String?
  parent        Discussion?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Discussion[] @relation("DiscussionReplies")
  message       String       @db.Text
  isSellerReply Boolean      @default(false)
  helpfulCount  Int          @default(0)
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?

  helpfuls DiscussionHelpful[]

  @@index([productId, parentId, createdAt])
}

model DiscussionHelpful {
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([discussionId, userId])
  @@index([userId])
}

// ============= FLASH SALE (event terjadwal, M15-C1) =============

// Beda dari diskon periodik produk (M9-B3): event ini dikurasi admin, terpusat,
// dan ber-kuota — jumlah unit yang dijual dengan harga flash dibatasi, bukan
// hanya rentang waktunya.
model FlashSale {
  id        String   @id @default(uuid())
  name      String
  startAt   DateTime
  endAt     DateTime
  // Jeda tanpa menghapus: event yang dijeda tetap "memesan" produknya terhadap
  // pemeriksaan tumpang tindih, supaya mengaktifkannya lagi tidak pernah
  // menghasilkan dua harga flash untuk produk yang sama di jam yang sama.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FlashSaleItem[]

  // Melayani satu-satunya query panas di sisi pembeli: event yang sedang
  // berjalan sekarang.
  @@index([isActive, startAt, endAt])
}

model FlashSaleItem {
  id          String    @id @default(uuid())
  flashSaleId String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Harga satuan selama event. Divalidasi < Product.price saat disimpan.
  salePrice   Int
  // Jumlah unit yang boleh terjual dengan harga flash.
  quota       Int
  // Dinaikkan atomik di dalam transaksi checkout, diturunkan lagi lewat
  // `restoreStock` saat pesanannya batal/kedaluwarsa/direfund.
  soldCount   Int       @default(0)

  orderItems OrderItem[]

  // Satu produk cukup sekali per event; dua baris untuk produk yang sama
  // membuat harga & kuotanya ambigu.
  @@unique([flashSaleId, productId])
  @@index([productId])
}

// ============= REPORT / PELAPORAN (M8-C2) =============

enum ReportTargetType {
  PRODUCT
  REVIEW
  SHOP
  DISCUSSION
  USER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  reason       String
  description  String?          @db.Text
  evidenceUrls String[]
  status       ReportStatus     @default(OPEN)
  adminNote    String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

// ============= CHAT TEMPLATE (M8-B6) =============

model ChatTemplate {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  label     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([shopId, order])
}

// ============= ETALASE / SHOWCASE TOKO (M11-B1) =============

model ShopShowcase {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  // Dibuat dari `name` saat create dan stabil setelahnya — URL etalase shareable,
  // rename hanya mengubah `name`.
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ShopShowcaseProduct[]

  @@unique([shopId, slug])
  @@index([shopId, order])
}

model ShopShowcaseProduct {
  showcaseId String
  showcase   ShopShowcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order      Int          @default(0)

  @@id([showcaseId, productId])
  @@index([showcaseId, order])
  @@index([productId])
}

// ============= FOLLOW TOKO (M13-A1) =============

// Tanpa kolom `id` sendiri: PK gabungan sudah unik dan sekaligus mencegah
// follow ganda saat tombol di-klik dua kali (upsert menabrak PK yang sama).
// Jumlah follower dihitung lewat `_count.followers`, bukan kolom counter —
// skalanya belum menuntut denormalisasi dan counter gampang melenceng.
model ShopFollower {
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([shopId, userId])
  // Daftar "Toko Favorit" milik user, terbaru dulu.
  @@index([userId, createdAt])
}

// ============= BROADCAST PROMO (M13-B2) =============

// Riwayat pengumuman toko ke follower. Tabel ini bukan sekadar arsip: baris
// terakhirnya adalah penegak rate limit 1x/24 jam (dicek lewat `sentAt`), jadi
// baris tetap ditulis sekali per pengiriman — jangan pernah dihapus rutin.
model ShopBroadcast {
  id             String   @id @default(uuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title          String
  body           String
  // Produk yang disorot (opsional). SetNull, bukan Cascade: produk dihapus
  // tidak boleh menghapus riwayat — kalau riwayatnya hilang, jendela 24 jam
  // ikut hilang dan seller bisa broadcast lagi seketika.
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Jangkauan saat dikirim. Disimpan, bukan dihitung ulang dari jumlah follower
  // sekarang — follower bisa bertambah/berkurang setelah broadcast terkirim.
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())

  // Riwayat per toko (terbaru dulu) sekaligus jalur cek rate limit.
  @@index([shopId, sentAt])
}
