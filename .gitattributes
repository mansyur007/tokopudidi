# Normalisasi line ending: repo ini dikerjakan lintas macOS/Windows/Linux.
* text=auto eol=lf

# Shell script & Dockerfile dieksekusi di VPS Linux — CRLF bikin gagal jalan.
*.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

# Binary — jangan pernah dinormalisasi.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
